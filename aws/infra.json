    "EcsExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {"Fn::Sub": "${ProjectName}-ecs-exec-role"},
        "AssumeRolePolicyDocument": { 
          "Version": "2012-10-17", 
          "Statement": [ 
            { 
              "Effect": "Allow", 
              "Principal": { "Service": "ecs-tasks.amazonaws.com" }, 
              "Action": "sts:AssumeRole" 
            } 
          ] 
        },
        "ManagedPolicyArns": [ "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy" ]
      }
    },
    "EcsLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": 
      { 
        "LogGroupName": { "Fn::Sub": "/ecs/${ProjectName}-services" }, 
        "RetentionInDays": 14 
      }
    },
    "TaskDefA": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": { "Fn::Sub": "${ProjectName}-service-${ServiceAName}" },
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "ExecutionRoleArn": { "Fn::GetAtt": ["EcsExecutionRole", "Arn"] },
        "TaskRoleArn": {"Fn::GetAtt": ["EcsTaskRole","Arn"]},
        "ContainerDefinitions": [{
            "Name": {"Ref": "ServiceAName"},
            "Image": {"Fn::Sub": "${AWS::AccountId}.dkr.ecr.${EcrRegion}.amazonaws.com/${ProjectName}-${ServiceAName}-images:${ImageTag}"},
            "PortMappings": [{"ContainerPort": {"Ref": "ContainerPort"},"Protocol": "tcp"}],
            "Environment": [
              {
                "Name": "DB_URL",
                "Value": {
                  "Fn::Sub": ["jdbc:postgresql://${DBHost}:${DBPort}/gymdb",
                    {
                      "DBHost": { "Fn::GetAtt": ["Db", "Endpoint.Address"] },
                      "DBPort": { "Ref": "DbPort" }
                    }
                  ]
                }
              },
              {"Name": "DB_USERNAME","Value": { "Ref": "DbUsername" }},
              {"Name": "DB_PASSWORD","Value": { "Ref": "DbPassword" }},
              {"Name": "SERVER_PORT","Value": { "Ref": "ContainerPort" }},
              {"Name": "JWT_SECRET","Value": { "Ref": "JWTSecret" }},
              {"Name": "USER_SERVICE_URL","Value": {"Fn::Sub": "http://${ServiceBName}.${ProjectName}.internal:${ContainerPort}"}},
              {"Name": "VNP_TMN_CODE","Value": { "Ref": "VnpTmnCode" }},
              {"Name": "VNP_HASH_SECRET","Value": { "Ref": "VnpHashSecret" }},
              {"Name": "VNP_URL","Value": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"},
              {"Name": "VNP_RETURN_URL","Value": {"Fn::Sub": "http://${ALB.DNSName}/api/v1/gym/payment/return"}}
            ],
            "LogConfiguration": { 
              "LogDriver": "awslogs", 
              "Options": 
              { 
                "awslogs-group": { "Ref": "EcsLogGroup" }, 
                "awslogs-region": { "Ref": "AWS::Region" }, 
                "awslogs-stream-prefix": {"Fn::Sub": "service-${ServiceAName}"}
              } 
            }
          }
        ]
      }
    },
    "TaskDefB": {
